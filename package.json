{
  "name": "momin-android",
  "private": true,
  "version": "1.0.1",
  "description": "Android wrapper for the existing MOMIN web app",
  "scripts": {
    "android:web": "node scripts/prepare-android-web.mjs",
    "android:prepare": "npm run android:web && node scripts/prepare-android-project.mjs",
    "android:debug": "npm run android:prepare && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run android:prepare && cd android && ./gradlew bundleRelease",
    "test:fcm": "node scripts/test-native-fcm.mjs",
    "test:tablet": "node scripts/test-tablet-responsive.mjs",
    "test:no-giving": "node scripts/test-no-giving-release.mjs",
    "test:notifications": "node scripts/test-notification-release.mjs",
    "android:signing:prepare": "node scripts/configure-android-signing.mjs",
    "test:sunrise": "node scripts/test-sunrise-display.mjs",
    "test:prayer-location": "node scripts/test-prayer-location-sync.mjs",
    "test:prayer-alarm-timing": "node scripts/test-prayer-alarm-timing.mjs",
    "test:profile-details": "node scripts/test-profile-details-persistence.mjs",
    "test:dua-navigation": "node scripts/test-dua-navigation.mjs",
    "test:prayer-sequence": "node scripts/test-prayer-event-sequence.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/push-notifications": "8.1.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "esbuild": "^0.25.0"
  }
}
